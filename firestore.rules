rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seka Club Database Security Rules
    
    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
      
      // User Wallet Transactions
      match /transactions/{txId} {
        allow read, write: if true;
      }
    }

    // Deposit Receipts submitted by players
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // Game Rooms & Real-time Table State
    match /rooms/{roomId} {
      allow read, write: if true;
    }

    // Support and Admin Messages
    match /admin_messages/{msgId} {
      allow read, write: if true;
    }

    // User Reports & Support Tickets
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // 10% Table Rakes / Table Bet House Commissions
    match /table_rakes/{rakeId} {
      allow read, write: if true;
    }

    // Registered Devices & IMEI Anti-Duplicate Security
    match /registered_devices/{deviceId} {
      allow read, write: if true;
    }

    // Direct Player-to-Player Messages & Proposals
    match /player_messages/{msgId} {
      allow read, write: if true;
    }

    // Comprehensive Activity Logs & System Audits
    match /activity_logs/{logId} {
      allow read, write: if true;
    }
  }
}
